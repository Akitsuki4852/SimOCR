<Window x:Class="SimOCR.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="SimOCR 识别结果"
        Width="920" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        Foreground="#FFF2F2F2"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="140" />
            <!-- 表格区用 Auto：识别不到表格 / TXT 模式时整块折叠，不留大片黑色空白 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" MinHeight="90" />
        </Grid.RowDefinitions>

        <!--
            预览区：鼠标移入时右下角浮现与覆盖层同款样式的工具条（编辑 / 保存 / ✕）。
            左下角是**统一提示框**：模式提示、分割线操作提示、保存结果、错误信息全部走这一个框
            （避免"黑色行文字"与"蓝色弹窗框"重复两套提示）。
        -->
        <Grid x:Name="PreviewHost"
              Grid.Row="0"
              Background="#FF101010"
              ClipToBounds="True"
              Cursor="Arrow"
              SizeChanged="OnPreviewSizeChanged"
              MouseEnter="OnPreviewMouseEnter"
              MouseLeave="OnPreviewMouseLeave"
              MouseLeftButtonDown="OnPreviewLeftButtonDown"
              MouseLeftButtonUp="OnPreviewLeftButtonUp"
              MouseMove="OnPreviewMouseMove"
              MouseDown="OnPreviewMouseDown">

            <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True" />

                <!-- 识别框（点选联动、右键删除都作用在这一层） -->
                <Canvas x:Name="BoxCanvas" Background="Transparent" />

                <!--
                    可编辑的表格分割线（快速识别的行列结构）：坐标与图片像素一一对应，
                    因此可以直接拖到任意位置；改完点「刷新」按新分割线重新落格。
                -->
                <Canvas x:Name="GridLineLayer" Background="Transparent" Visibility="Collapsed" />

                <!-- 编辑模式的橡皮筋框 -->
                <Canvas x:Name="EditLayer" IsHitTestVisible="False">
                    <Rectangle x:Name="RubberBand" Visibility="Collapsed"
                               Stroke="#FF2E9E4A" StrokeThickness="1" Fill="#332E9E4A" />
                </Canvas>
            </Grid>

            <!-- 识别中提示 -->
            <Border x:Name="BusyPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource ToolbarPanelStyle}" Padding="14,8">
                <TextBlock x:Name="BusyText" Text="正在识别…" FontSize="13" />
            </Border>

            <!-- 统一提示框（左下角）：编辑模式 / 分割线编辑 / 保存结果 / 错误 都显示在这里。
                 这里（原 HintBar）与下面的关闭按钮（原 CloseButton）过去各挂一个
                 `x:Name`，但 C# 侧**从未引用**（实测命中 0）—— 只写不读的名字会让"这个元素被谁
                 改过"变得不可查，故删名；元素本身、样式、可见性与点击行为一字未动。 -->
            <Border
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                    Style="{StaticResource ToolbarPanelStyle}" Padding="10,5">
                <TextBlock x:Name="StatusText" Text="准备中…" FontSize="12"
                           Foreground="#FF9FE6FF" TextWrapping="Wrap" MaxWidth="1100" />
            </Border>

            <!--
                悬停工具条（鼠标移入预览区时右下角浮现，与覆盖层同款样式）。
                六个操作按钮都放在这里，顺序为
                [文本框][⌗分割线][🔄刷新][💡增强][💾保存][✕关闭]；移开淡出。
            -->
            <Border x:Name="PreviewToolbar"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                    Style="{StaticResource ToolbarPanelStyle}"
                    Opacity="0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EditButton" Style="{StaticResource ToolButtonStyle}"
                            Content="&#xE70F;"
                            ToolTip="编辑文本框（左键拖框补识别 / 右键点框删除 / 中键退出）"
                            Click="OnEditClick" />
                    <Button x:Name="GridEditButton" Style="{StaticResource ToolButtonStyle}"
                            Content="&#x2317;" FontFamily="Segoe UI Symbol"
                            ToolTip="编辑分割线（拖动 = 移动 · 右键 = 删除 · 空白双击 = 新增列线 / Shift+双击 = 新增行线 · 中键退出）"
                            Click="OnGridEditClick" />
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolButtonStyle}"
                            Content="&#xE72C;"
                            ToolTip="刷新：按当前分割线重新填格；刚跑过「增强识别」时则重新运行通用识别"
                            Click="OnRefreshClick" />
                    <Button x:Name="EnhanceButton" Style="{StaticResource ToolButtonStyle}"
                            Content="&#xE945;"
                            ToolTip="增强识别：按列放大定向重认 + 数值/格式校验 + 表格语义"
                            Click="OnEnhanceClick" />
                    <Button x:Name="SaveButton" Style="{StaticResource ToolButtonStyle}"
                            Content="&#xE74E;" ToolTip="保存到设置的保存目录（Shift+点击 = 另存为…）" Click="OnSaveClick" />
                    <Button Style="{StaticResource ToolButtonStyle}"
                            Content="&#xE711;" ToolTip="关闭" Click="OnCloseClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            表格预览：左侧是状态（来源/校验摘要），右侧是导出信息（格式 · 像素）与表格形状。
            六个操作按钮已**全部放在预览区的悬停工具条**，这里不再放按钮。
        -->
        <Border Grid.Row="1" x:Name="TableHost"
                Visibility="Collapsed"
                Background="#FF141414" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FF232323" Padding="10,4">
                    <Grid>
                        <TextBlock x:Name="TableStatus" Text="表格预览" FontSize="12"
                                   Foreground="#FFCFD8DC" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,330,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TableInfo" FontSize="11" Foreground="#FF9E9E9E"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="TableShape" FontSize="11" Foreground="#FFB0BEC5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DataGrid x:Name="TablePreview"
                          MinHeight="90" MaxHeight="240"
                          Background="#FF141414" Foreground="#FFF2F2F2"
                          BorderThickness="0" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#33FFFFFF" VerticalGridLinesBrush="#33FFFFFF"
                          RowBackground="#FF181818" AlternatingRowBackground="#FF1D1D1D"
                          HeadersVisibility="Column" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" SelectionUnit="Cell"
                          FontSize="12" RowHeight="22"
                          CanUserSortColumns="True"
                          Sorting="OnTableSorting"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <!--
                        表头配色：原来用系统默认浅色表头（白底/亮灰），在深色界面上又刺眼又难读。
                        这里改成"比背景黑只亮一点点"的深灰 + 浅灰字；表头点击排序（升 → 降 → 取消）。
                    -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF262626" />
                            <Setter Property="Foreground" Value="#FFD6D6D6" />
                            <Setter Property="BorderBrush" Value="#33FFFFFF" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 识别文本（可编辑） -->
        <TextBox x:Name="TextHost"
                 Grid.Row="2"
                 Background="#FF151515" Foreground="#FFF2F2F2" CaretBrush="#FFF2F2F2"
                 BorderThickness="0" Padding="8"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextChanged="OnTextHostTextChanged"
                 SelectionChanged="OnTextSelectionChanged" />
    </Grid>
</Window>
