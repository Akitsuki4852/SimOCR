<Window x:Class="SimOCR.Pinning.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="SimOCR 贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#FF1B1B1B"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Cursor="SizeAll">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuCopy" Header="复制到剪贴板" />
            <MenuItem x:Name="MenuSave" Header="保存为 PNG…" />
            <Separator />
            <MenuItem x:Name="MenuClose" Header="关闭贴图 (Esc)" />
            <MenuItem x:Name="MenuCloseAll" Header="关闭全部贴图" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border BorderBrush="#FF2E9E4A" BorderThickness="1" Background="#FF1B1B1B">
        <Image x:Name="PinnedImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
</Window>
