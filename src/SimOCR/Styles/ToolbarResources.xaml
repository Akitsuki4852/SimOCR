<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        工具条按钮样式：覆盖层（截图选区右下角）与识别结果窗口（预览图右下角）**共用同一份**，
        保证两处工具条外观一致。
    -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Background" Value="#FF2B2B2B" />
        <Setter Property="Foreground" Value="#FFF2F2F2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF2E9E4A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF1F7A36" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        导出按钮（TXT/DOCX/PDF/XLSX）：与图标按钮同一外观，但内容是短文字标签，
        因此宽度自适应、字号更小、用界面字体而不是图标字体。
        需求是"四个按钮各自独立元素、等距" —— 所以每个都是独立 Button，不合并成一个控件。
    -->
    <Style x:Key="ToolTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 工具条分组之间的 1px 分隔线（导出组 │ 常用动作组） -->
    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="5,4" />
        <Setter Property="Background" Value="#59FFFFFF" />
    </Style>

    <!-- 工具条容器（覆盖层与识别窗口共用外观） -->
    <Style x:Key="ToolbarPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#E61B1B1B" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="3" />
    </Style>

</ResourceDictionary>
