<Window x:Class="SimOCR.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="SimOCR 设置"
        Width="620"
        Height="720"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        FontSize="13"
        Background="#FFF7F7F7"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF1F7A36" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF333333" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- 底部按钮条 -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="关闭" Width="88" Height="30" Margin="6,0,0,0" Click="OnCloseClick" />
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="#FF777777" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 截图 -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="截图" Style="{StaticResource SectionTitleStyle}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局热键" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="HotkeyCombo" Grid.Column="1" IsEditable="True" Height="26" />
                            <!-- 本按钮的 `x:Name` C# 侧从未引用（走 Click="OnCheckHotkeyClick"），故不留名字 -->
                            <Button Grid.Column="2" Content="检测冲突" Width="86" Height="26"
                                    Margin="8,0,0,0" Click="OnCheckHotkeyClick" />
                        </Grid>
                        <TextBlock x:Name="HotkeyStatusText" Foreground="#FF777777" FontSize="12" Margin="110,0,0,10" />

                        <CheckBox x:Name="AutoSaveCheck" Content="松开左键后直接保存（不显示工具条）" />
                        <CheckBox x:Name="CloseAfterActionCheck" Content="保存 / 复制 / 置顶后自动关闭覆盖层" />

                        <!-- 窗口吸附 -->
                        <CheckBox x:Name="SnapToWindowsCheck" Content="窗口吸附（截图时吸附到窗口/屏幕边缘）" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="吸附容差" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="SnapToleranceCombo" Grid.Column="1" Height="26">
                                <ComboBoxItem Content="关闭（0 像素）" Tag="0" />
                                <ComboBoxItem Content="4 像素" Tag="4" />
                                <ComboBoxItem Content="8 像素（默认）" Tag="8" />
                                <ComboBoxItem Content="12 像素" Tag="12" />
                                <ComboBoxItem Content="16 像素" Tag="16" />
                                <ComboBoxItem Content="24 像素" Tag="24" />
                                <ComboBoxItem Content="40 像素（最大）" Tag="40" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Foreground="#FF777777" FontSize="12" Margin="110,0,0,8" TextWrapping="Wrap"
                                   Text="容差内吸附到附近窗口/显示器边缘，移开就脱开（不会粘住）；光标停在窗口上会高亮整窗，单击即抓取整个窗口。改完立即生效，已打开的覆盖层也不会被打断。" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="双击选区动作" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="DoubleClickCombo" Grid.Column="1" Height="26">
                                <ComboBoxItem Content="复制到剪贴板（默认）" Tag="copy" />
                                <ComboBoxItem Content="保存为 PNG" Tag="save" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 保存 -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="保存" Style="{StaticResource SectionTitleStyle}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保存目录" Style="{StaticResource RowLabelStyle}" />
                            <TextBox x:Name="SaveDirBox" Grid.Column="1" Height="26" />
                            <Button Grid.Column="2" Content="浏览…" Width="66" Height="26" Margin="8,0,0,0" Click="OnBrowseSaveDirClick" />
                            <Button Grid.Column="3" Content="打开" Width="56" Height="26" Margin="6,0,0,0" Click="OnOpenSaveDirClick" />
                        </Grid>
                        <TextBlock x:Name="SaveDirHint" Foreground="#FF777777" FontSize="12" Margin="110,0,0,10" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件名模板" Style="{StaticResource RowLabelStyle}" />
                            <TextBox x:Name="FileNameTemplateBox" Grid.Column="1" Height="26" />
                        </Grid>
                        <TextBlock Foreground="#FF777777" FontSize="12" Margin="110,0,0,8"
                                   Text="可用占位符：{yyyy} {MM} {dd} {HH} {mm} {ss} {fff}；重名会自动追加 _1、_2…" TextWrapping="Wrap" />

                        <CheckBox x:Name="PlaySoundCheck" Content="保存成功时播放提示音" />
                        <CheckBox x:Name="BalloonCheck" Content="显示托盘气泡提示" />
                    </StackPanel>
                </Border>

                <!-- 覆盖层 -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="覆盖层 / 取色" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="MagnifierCheck" Content="显示放大镜与取色信息" />
                        <CheckBox x:Name="SizeLabelCheck" Content="显示选区尺寸标签" />
                        <CheckBox x:Name="ResizeSelectionCheck" Content="允许松开后调整选区大小（8 个控制点）" />

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="放大倍率" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="ZoomCombo" Grid.Column="1" Height="26" Margin="0,0,10,0">
                                <ComboBoxItem Content="4×" Tag="4" />
                                <ComboBoxItem Content="8×" Tag="8" />
                                <ComboBoxItem Content="16×" Tag="16" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="采样像素" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="SampleCombo" Grid.Column="3" Height="26">
                                <ComboBoxItem Content="9 × 9" Tag="9" />
                                <ComboBoxItem Content="15 × 15" Tag="15" />
                                <ComboBoxItem Content="21 × 21" Tag="21" />
                                <ComboBoxItem Content="31 × 31" Tag="31" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OCR 识别 -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="OCR 识别" Style="{StaticResource SectionTitleStyle}" />

                        <!-- 表格解析配置档（0.8.1 起：可选内置档名，也可浏览自备 YAML） -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="表格配置档" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="TableProfileCombo" Grid.Column="1" Height="26"
                                      SelectionChanged="OnTableProfileChanged" />
                            <Button Grid.Column="2" Content="浏览…" Width="66" Height="26" Margin="8,0,0,0"
                                    Click="OnBrowseProfileClick" />
                            <Button Grid.Column="3" Content="打开文件夹" Width="88" Height="26" Margin="6,0,0,0"
                                    Click="OnOpenProfileFolderClick" />
                        </Grid>
                        <TextBlock x:Name="TableProfileStatus" Foreground="#FF777777" FontSize="12"
                                   Margin="110,0,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="TableProfileError" Foreground="#FFC42B1C" FontSize="12"
                                   Margin="110,0,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock Foreground="#FF777777" FontSize="12" Margin="110,0,0,8" TextWrapping="Wrap"
                                   Text="配置文件名 = Profiles 目录里的 YAML 文件名（不含 .yaml），如 default、example-invoice-packing；写错文件名会自动回退到 default。自备 YAML 用「浏览…」选，解析失败会在上面明确报错、不会静默忽略。改完立即生效，下次启动沿用。" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="置信度阈值" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="TextScoreCombo" Grid.Column="1" Height="26" Margin="0,0,10,0"
                                      SelectionChanged="OnTextScoreChanged">
                                <ComboBoxItem Content="0.2（召回优先，可能带噪）" Tag="0.2" />
                                <ComboBoxItem Content="0.3（默认，推荐）" Tag="0.3" />
                                <ComboBoxItem Content="0.4" Tag="0.4" />
                                <ComboBoxItem Content="0.5（准确优先，可能漏字）" Tag="0.5" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="大图放大上限" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="ImgResizeCombo" Grid.Column="3" Height="26"
                                      SelectionChanged="OnImgResizeChanged">
                                <ComboBoxItem Content="1500（快）" Tag="1500" />
                                <ComboBoxItem Content="2000（默认）" Tag="2000" />
                                <ComboBoxItem Content="2500（大图小字更稳，慢）" Tag="2500" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Foreground="#FF777777" FontSize="12" Margin="110,0,0,0" TextWrapping="Wrap"
                                   Text="阈值越低保留越多低置信文字行（召回高、可能带噪），越高越严格。改完立即生效，无需重启。" />

                        <!-- OCR 模型目录（0.8.1 起：默认随包，也可指向别处的模型） -->
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OCR 模型目录" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="OcrModelCombo" Grid.Column="1" Height="26"
                                      SelectionChanged="OnOcrModelChanged" />
                            <Button Grid.Column="2" Content="浏览…" Width="66" Height="26" Margin="8,0,0,0"
                                    Click="OnBrowseOcrModelClick" />
                            <Button Grid.Column="3" Content="打开文件夹" Width="88" Height="26" Margin="6,0,0,0"
                                    Click="OnOpenOcrModelFolderClick" />
                        </Grid>
                        <TextBlock x:Name="OcrModelStatus" Foreground="#FF777777" FontSize="12" Margin="110,0,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="OcrModelError" Foreground="#FFC42B1C" FontSize="12" Margin="110,0,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock Foreground="#FF777777" FontSize="12" Margin="110,0,0,4" TextWrapping="Wrap"
                                   Text="一般保持「自动」即可，用的是程序自带的模型。要用自己准备的模型，点「浏览…」选文件夹；选错了会自动回到自带的模型，并在上方提示。模型只在启动时加载，改完要重启 SimOCR 才生效。" />
                    </StackPanel>
                </Border>

                <!-- 启动与常驻 -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="启动与常驻" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="EnabledCheck" Content="启用（关闭后全局热键暂停，托盘图标变灰）" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动（当前用户，无需管理员权限）" />
                        <TextBlock x:Name="AutoStartStatusText" Foreground="#FF777777" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 信息 -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="运行信息" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="AboutText" Foreground="#FF555555" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="开源许可" Width="88" Height="26" Margin="0,0,8,0" Click="OnShowLicenseClick" />
                            <Button Content="打开配置目录" Width="110" Height="26" Margin="0,0,8,0" Click="OnOpenDataDirClick" />
                            <Button Content="打开日志目录" Width="110" Height="26" Margin="0,0,8,0" Click="OnOpenLogDirClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
