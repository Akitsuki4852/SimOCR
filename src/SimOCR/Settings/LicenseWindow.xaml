<Window x:Class="SimOCR.Settings.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="SimOCR 开源许可"
        Width="780"
        Height="580"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="13"
        Background="#FFF7F7F7"
        TextOptions.TextFormattingMode="Display">

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Width="88" Height="30" Click="OnCloseClick" />
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="第三方组件（NOTICE）">
                <TextBox x:Name="NoticeText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         Padding="10,8"
                         FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Apache-2.0（LICENSE）">
                <TextBox x:Name="LicenseText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         Padding="10,8"
                         FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
